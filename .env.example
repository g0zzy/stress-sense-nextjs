# Google Gemini API Key
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# Stress Sense API Configuration (Server-side only)
# Your backend API URL - NOT exposed to the browser
STRESS_API_BASE_URL=https://stress-sense-v3-1032027763517.europe-west1.run.app

# API Secret Key for authentication with your backend
# Generate a secure random string and add the same key to your Cloud Run service
# Example: openssl rand -base64 32
STRESS_API_SECRET=your_api_secret_key_here
